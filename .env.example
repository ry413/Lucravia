# DashScope key is read only by the Python server.
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# Amap Web Service API key, used only by the Python server for POI and routes.
AMAP_API_KEY=your-amap-web-service-key

# Android compiles this LAN address into the development APK.
# Replace it with the server computer's LAN IP; do not use 127.0.0.1.
VLM_SERVER_URL=http://192.168.1.100:8765
